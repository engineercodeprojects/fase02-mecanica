# Stage 01 — Cluster: exemplo de variaveis. Copie para terraform.tfvars
# (que NAO e versionado) e ajuste se necessario.

project_name      = "oficina-mecanica"
kind_cluster_name = "oficina-local"
kind_worker_count = 2
# kind_node_image = "kindest/node:v1.31.2"  # opcional: pinar a versao do node
kubeconfig_path = "~/.kube/oficina-mecanica.config"
